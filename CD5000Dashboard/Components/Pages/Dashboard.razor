@page "/"
@inject CD5000Dashboard.Data.DashboardRepository Repository

<PageTitle>CD5000 Dashboard</PageTitle>

<h1 class="mb-4">CD5000 Dashboard</h1>

@if (_loading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Total Transactions</h5>
                    <p class="display-6 mb-0">@_transactionCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Missing RFID Tags</h5>
                    <p class="display-6 mb-0">@_missingRfid.Count()</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Top Products Shown</h5>
                    <p class="display-6 mb-0">@_topProducts.Count()</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <strong>Transactions by Hour</strong>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Hour</th>
                                <th>Transactions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _hourlyData)
                            {
                                <tr>
                                    <td>@item.Hour</td>
                                    <td>@item.TransactionCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <strong>Top Products</strong>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Product Code</th>
                                <th>Transactions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _topProducts)
                            {
                                <tr>
                                    <td>@item.ProductCode</td>
                                    <td>@item.TransactionCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Rail Cars Missing RFID Tags</strong>
                </div>
                <div class="card-body">
                    @if (_missingRfid.Any())
                    {
                        <div style="overflow-x:auto;">
                            <table class="table table-striped table-bordered table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Pk</th>
                                        <th>Vehicle</th>
                                        <th>Tag Id</th>
                                        <th>Unit Train</th>
                                        <th>Start Date</th>
                                        <th>Start Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _missingRfid)
                                    {
                                        <tr>
                                            <td>@item.Pk</td>
                                            <td>@item.Vehicle</td>
                                            <td>@item.TagId</td>
                                            <td>@item.UnitTrain</td>
                                            <td>@item.StartDate</td>
                                            <td>@item.StartTime</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="mb-0">No missing RFID records found.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Average Duration by Vehicle</strong>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Vehicle</th>
                                <th>Avg Duration (sec)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _avgDurationByVehicle)
                            {
                                <tr>
                                    <td>@item.Vehicle</td>
                                    <td>@item.AverageDurationSeconds</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Average Duration by Unit Train</strong>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Unit Train</th>
                                <th>Avg Duration (sec)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _avgDurationByUnitTrain)
                            {
                                <tr>
                                    <td>@item.UnitTrain</td>
                                    <td>@item.AverageDurationSeconds</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}